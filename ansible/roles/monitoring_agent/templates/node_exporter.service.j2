[Unit]
Description=Prometheus Node Exporter
Documentation=https://github.com/prometheus/node_exporter
After=network.target

[Service]
Type=simple
User=node_exporter
Group=node_exporter
ExecStart=/usr/local/bin/node_exporter --web.listen-address=:{{ node_exporter_port | default(9100) }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
